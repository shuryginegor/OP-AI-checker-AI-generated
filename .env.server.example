# ==============================================================================
# Конфигурация для РОССИЙСКОГО СЕРВЕРА (Web UI + PostgreSQL + Медиа + GigaChat)
# Скопируйте этот файл в .env на российском сервере: cp .env.server.example .env
# ==============================================================================

# 1. Порт веб-приложения (по умолчанию 3000, перед ним обычно ставят Nginx с HTTPS)
PORT=3000

# 2. Telegram Bot Token
# Нужен серверу для отправки 2FA кодов подтверждения и отчетов анализа кураторам
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 3. База данных PostgreSQL 16 (Локализована в РФ, 152-ФЗ)
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=lecture_db
DB_PORT=5432

# 4. API-ключ КТалк для скачивания лекций (скачивание происходит в РФ!)
TALK_API_KEY=your_ktalk_api_token_here

# 5. Доступ к Сбер GigaChat API (выполняется строго из РФ!)
GIGACHAT_CREDENTIALS=your_gigachat_auth_credentials_here
# Либо Client ID + Secret:
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Pro

# 6. Секретный криптографический ключ подписи ссылок (HMAC-SHA256)
# ВНИМАНИЕ: Должен совпадать со значением на зарубежном сервере!
TOKEN_SECRET=olymp-secret-key-2026-checker-secret-secure-salt-2026

# 7. Списки администраторов (без знака @)
ADMIN_USERNAMES=shurygin_egor,aemss72
PROMPT_ADMIN_USERNAMES=shurygin_egor,aemss72

# 8. Логирование
LOG_LEVEL=INFO
TESTING_MODE=false
