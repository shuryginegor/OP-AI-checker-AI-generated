# ==============================================================================
# Dockerfile для Российского Сервера (Web UI, API, Редактор промптов, База,
# СКАЧИВАНИЕ ЛЕКЦИЙ, ОБРАБОТКА МЕДИА И ОТПРАВКА В СБЕР GIGACHAT)
# ==============================================================================
# Российский сервер обеспечивает:
# 1. Локализацию базы данных и ПДн преподавателей в РФ (152-ФЗ)
# 2. Скачивание видеозаписей и материалов из КТалк на российский диск
# 3. Нарезку аудиодорожек и ключевых кадров (ffmpeg)
# 4. Анализ встреч через Сбер GigaChat-2-Pro (сертификаты Минцифры РФ)
# 5. Веб-панель аналитики, разовые ссылки и редактор системного промпта
# ==============================================================================

# ------------------------------------------------------------------------------
# ЭТАП 1: Сборка React фронтенда и Node.js сервера
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json* bun.lock* ./
RUN npm install

COPY tsconfig.json tsconfig.server.json vite.config.ts index.html *.ts ./
COPY src ./src
COPY public ./public
RUN npm run build

# ------------------------------------------------------------------------------
# ЭТАП 2: Финальный рабочий образ (с ffmpeg, venv и сертификатами Минцифры РФ)
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC
WORKDIR /app

# Установка Python3, ffmpeg для нарезки видео, curl и сертификатов
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    procps \
    ca-certificates \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Изолированное Python-окружение (готовые бинарные wheel для pillow/asyncpg/moviepy)
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Установка всех Python-зависимостей
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Установка только production npm-пакетов
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# Копирование скомпилированного фронтенда и бандла сервера
COPY --from=builder /app/dist ./dist

# Копирование Python-модулей, конфигов и сертификатов
COPY *.py ./
COPY metadata.json db_schema.jpg COMPLIANCE_152FZ.md ./
COPY certs ./certs

# Установка доверенных корневых сертификатов Минцифры РФ (для API Сбера)
RUN if [ -f certs/russian_trusted_root_ca.pem ]; then \
        cp certs/russian_trusted_root_ca.pem /usr/local/share/ca-certificates/russian_trusted_root_ca.crt && \
        update-ca-certificates; \
    fi

# Директории для постоянного хранения данных и временной обработки медиа
RUN mkdir -p /app/data /app/artifacts /app/temp_lectures && \
    chmod -R 777 /app/data /app/artifacts /app/temp_lectures

# Переменные окружения по умолчанию
ENV NODE_ENV=production \
    PORT=3000 \
    RUN_LOCAL_BOT=false \
    RUN_RUSSIAN_WORKER=true \
    DB_TYPE=postgres \
    DB_HOST=postgres \
    DB_PORT=5432 \
    DB_USER=postgres \
    DB_PASSWORD=postgres_password \
    DB_NAME=lecture_db \
    PYTHONUNBUFFERED=1

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/config || exit 1

# Запуск единого производственного сервера
CMD ["node", "dist/server.cjs"]
