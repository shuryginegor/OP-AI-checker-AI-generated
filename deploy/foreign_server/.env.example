# ==============================================================================
# Конфигурация для ЗАРУБЕЖНОГО СЕРВЕРА (Только легкий Telegram Bot)
# Скопируйте этот файл в .env на зарубежном сервере: cp .env.bot.example .env
# ==============================================================================

# 1. Telegram Bot Token (получен от @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Подключение к базе данных PostgreSQL на РОССИЙСКОМ сервере
# Укажите внешний IP-адрес или домен вашего российского сервера!
DB_HOST=185.xxx.xxx.xxx
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=lecture_db

# 3. Режим делегирования обработки лекций в РФ (true)
REMOTE_PROCESSOR_MODE=true

# 4. Публичный адрес веб-панели на РОССИЙСКОМ сервере
# Этот URL бот отправляет кураторам в кнопках "Открыть веб-отчет со статистикой"
WEB_BASE_URL=https://metodist.your-domain.ru

# 5. Секретный ключ подписи разовых токенов (ДОЛЖЕН СОВПАДАТЬ с российским сервером!)
TOKEN_SECRET=olymp-secret-key-2026-checker-secret-secure-salt-2026

# 6. Администраторы
ADMIN_USERNAMES=shurygin_egor,aemss72
PROMPT_ADMIN_USERNAMES=shurygin_egor,aemss72

# 7. Логирование
LOG_LEVEL=INFO
TESTING_MODE=false
