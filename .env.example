# ==============================================================================
# КОНФИГУРАЦИЯ ПРОЕКТА ДЛЯ ЗАПУСКА НА УДАЛЕННОМ СЕРВЕРЕ (DOCKER / UBUNTU)
# Скопируйте этот файл в .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОБЯЗАТЕЛЬНЫЕ КЛЮЧИ ДОСТУПА (вставьте ваши значения)
# ------------------------------------------------------------------------------

# Токен вашего Telegram-бота (получите у @BotFather в Telegram)
BOT_TOKEN=

# Ключ авторизации GigaChat (Base64 строка из личного кабинета Сбербанка/Developers)
GIGACHAT_CREDENTIALS=

# Токен авторизации для API сервиса видеовстреч КТалк (X-Auth-Token)
TALK_API_KEY=

# ------------------------------------------------------------------------------
# 2. АДРЕС СЕРВИСА И ССЫЛКИ
# ------------------------------------------------------------------------------

# Базовый адрес веб-интерфейса для генерации ссылок на статистику в Telegram.
# Укажите IP-адрес вашего сервера (например: http://194.87.123.45:3000)
# или ваш домен (например: https://ai-checker.mydomain.ru).
# Если оставить пустым, бот автоматически сформирует ссылку на порт 3000.
APP_URL=http://localhost:3000

# Порт веб-приложения на хосте (по умолчанию 3000)
PORT=3000

# Секретный криптографический ключ для цифровой подписи ссылок (HMAC-SHA256).
# По умолчанию задан безопасный ключ, при желании можно сгенерировать свой: openssl rand -hex 32
TOKEN_SECRET=olymp-secret-key-2026-checker-secret-secure-salt-2026

# ------------------------------------------------------------------------------
# 3. АДМИНИСТРАТОРЫ СИСТЕМЫ
# ------------------------------------------------------------------------------

# Юзернеймы администраторов через запятую (БЕЗ символа @), имеющих доступ к управлению ботом
ADMIN_USERNAMES=shurygin_egor,aemss72

# Юзернеймы администраторов, имеющих доступ к веб-панели редактирования системного промпта нейросети
# При входе на сайт пользователю из этого списка отправляется 6-значный код подтверждения в Telegram-бот
PROMPT_ADMIN_USERNAMES=shurygin_egor,aemss72

# ------------------------------------------------------------------------------
# 4. БАЗА ДАННЫХ (PostgreSQL 16)
# Эти параметры автоматически согласованы со встроенным сервисом postgres в docker-compose.yml
# ------------------------------------------------------------------------------

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=lecture_db

# ------------------------------------------------------------------------------
# 5. НАСТРОЙКИ НЕЙРОСЕТИ GIGACHAT
# ------------------------------------------------------------------------------

AI_PROVIDER=gigachat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_MINCIFRY_ROOT_URL=https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
GIGACHAT_MINCIFRY_SUB_URL=https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt

# ------------------------------------------------------------------------------
# 6. СИСТЕМНЫЕ ПАРАМЕТРЫ
# ------------------------------------------------------------------------------

# Уровень логирования (INFO для рабочего сервера, DEBUG для поиска ошибок)
LOG_LEVEL=INFO

# Режим тестирования: false для продакшена (моки и тестовые заглушки отключены)
TESTING_MODE=false
NODE_ENV=production

# ------------------------------------------------------------------------------
# 7. ПОЧТОВЫЙ ШЛЮЗ ДЛЯ ОТПРАВКИ EMAIL-КОДОВ (SMTP)
# Необходим для реальной доставки 6-значных кодов подтверждения на email кураторов.
# Если эти параметры не заполнены, сервер работает в безопасном режиме разработчика (коды пишутся в лог).
# ------------------------------------------------------------------------------

# 1. Пример для Яндекс 360 / Яндекс.Почты (доменной или обычной):
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=auth@olympiadpractices.ru
# SMTP_PASS=ваш_пароль_приложений_яндекса_16_символов
# SMTP_FROM="Олимпиадные Практики <auth@olympiadpractices.ru>"

# 2. Пример для Mail.ru / VK WorkSpace (корпоративная почта для бизнеса):
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=auth@olympiadpractices.ru
# SMTP_PASS=ваш_пароль_для_внешних_приложений_mailru
# SMTP_FROM="Олимпиадные Практики <auth@olympiadpractices.ru>"

# 3. Пример для Gmail (Google Workspace или обычный @gmail.com):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=ваш_16_значный_пароль_приложений_google
# SMTP_FROM="Олимпиадные Практики <youraccount@gmail.com>"

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
